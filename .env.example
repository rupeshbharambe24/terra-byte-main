# ---------------------------------------------------------------
# Frontend (Vite) - optional; defaults to the project's public
# client config if unset. Copy to .env.local to override.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ---------------------------------------------------------------
# Backend (Flask) - export these in the shell before running
# backend/app.py or backend/current_market_prices.py
# ---------------------------------------------------------------
# Path to your Firebase Admin SDK service-account JSON (never commit it).
# Defaults to backend/firebase-serviceAccountKey.json (git-ignored).
FIREBASE_CREDENTIALS=/absolute/path/to/firebase-serviceAccountKey.json
# Google Gemini key used by disease detection explanations
GEMINI_API_KEY=your-gemini-api-key
# data.gov.in key for live mandi prices (current_market_prices.py)
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
