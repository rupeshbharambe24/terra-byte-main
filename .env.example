# ---------------------------------------------------------------
# Frontend (Vite). Copy to .env.local to override. Both optional.
# ---------------------------------------------------------------
# Base URL of the TerraByte API. The default "/api" goes through the Vite dev proxy.
VITE_API_BASE_URL=/api
# Where the dev proxy forwards /api (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ---------------------------------------------------------------
# Backend (FastAPI): see backend/.env.example and copy it to backend/.env.
# Secrets (JWT_SECRET, DATA_GOV_IN_API_KEY) go only in backend/.env, never in git.
# ---------------------------------------------------------------
