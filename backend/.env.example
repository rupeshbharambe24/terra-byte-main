# Copy to backend/.env (git-ignored). Every value is optional in development.

# development | production. Production requires JWT_SECRET and disables /api/docs.
ENVIRONMENT=development

# SQLite file by default (backend/data/terrabyte.db). Postgres later, e.g.
# DATABASE_URL=postgresql+psycopg://terrabyte:password@localhost:5432/terrabyte
# DATABASE_URL=sqlite:///./data/terrabyte.db

# HS256 signing secret for access tokens. In development a random one is generated and stored
# in backend/data/.jwt_secret if this is empty. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=1440

# Comma-separated list of allowed browser origins (the Vite dev server runs on :8080).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=8

# Free key from https://data.gov.in (My Account -> API key); used by the mandi price ingest
# (Phase 3). Never commit it.
DATA_GOV_IN_API_KEY=
