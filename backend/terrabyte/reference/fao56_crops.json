{
 "meta": {
  "title": "FAO-56 single crop coefficient parameters",
  "compiled": "2026-11-24",
  "source": "Allen, Pereira, Raes & Smith (1998) FAO Irrigation and Drainage Paper 56, Crop evapotranspiration",
  "source_urls": {
   "table_11_stage_lengths": "https://www.fao.org/4/x0490e/x0490e0b.htm#TABLE 11",
   "table_12_kc": "https://www.fao.org/4/x0490e/x0490e0b.htm#TABLE 12",
   "table_22_root_p": "https://www.fao.org/4/x0490e/x0490e0e.htm#TABLE 22",
   "table_23_salinity_table_24_ky": "https://www.fao.org/4/x0490e/x0490e0e.htm"
  },
  "conventions": "Kc values from Table 12 for sub-humid climate (RHmin ~45%, u2 ~2 m/s). Where Table 12 leaves Kc_ini blank for a crop, the crop-group value printed on the group header row is used. Strings like '1.15-1.20' and '0.70-0.50' are FAO ranges. stage_lengths_days rows are FAO examples by region; recommended_stage_set = index of the row closest to Maharashtra conditions (TerraByte suggestion). Local stage dates (crop_calendar_maharashtra.json) should override FAO totals; scale the four stages proportionally.",
  "et0": "Use Open-Meteo daily et0_fao_evapotranspiration (FAO-56 Penman-Monteith ET0, mm/day) as ET0.",
  "crop_keys": "Crop keys harmonised with crop_calendar_maharashtra.json"
 },
 "formulas": {
  "ETc": "ETc = Kc x ET0 (FAO-56 Eq. 58)",
  "Kc_curve": "Kc = Kc_ini during initial stage; linear from Kc_ini to Kc_mid over development; Kc_mid over mid-season; linear from Kc_mid to Kc_end over late season (FAO-56 Eq. 66)",
  "Kc_mid_climate_adjustment": "Kc_mid = Kc_mid(Tab) + [0.04(u2 - 2) - 0.004(RHmin - 45)] (h/3)^0.3 (FAO-56 Eq. 62; valid for 1 <= u2 <= 6 m/s, 20 <= RHmin <= 80 %, 0.1 < h < 10 m)",
  "Kc_end_climate_adjustment": "Same form as Eq. 62, applied only when Kc_end(Tab) > 0.45 (FAO-56 Eq. 65)",
  "Kc_ini_note": "Kc_ini depends strongly on wetting interval and ET0; FAO-56 Figs 29-30 / Eq. 59-60 give Kc_ini as a function of time between wetting events. Table values are typical.",
  "TAW": "TAW = 1000 (theta_FC - theta_WP) Zr  [mm] (FAO-56 Eq. 82)",
  "RAW": "RAW = p x TAW (FAO-56 Eq. 83)",
  "p_adjustment": "p = p(Table 22) + 0.04 (5 - ETc), limited to 0.1 <= p <= 0.8 (FAO-56 Table 22 footnote/text)",
  "Ks": "Ks = (TAW - Dr) / ((1 - p) TAW) when Dr > RAW, else 1 (FAO-56 Eq. 84); ETc_adj = Ks x Kc x ET0",
  "daily_water_balance": "Dr,i = Dr,i-1 - (P - RO)i - Ii - CRi + ETc,i + DPi (FAO-56 Eq. 85). Irrigate when Dr >= RAW; net irrigation = Dr.",
  "Zr_growth": "Root depth grows from ~0.15-0.20 m at sowing to Zr max (Table 22) at start of mid-season; FAO-56 interpolates linearly (TerraByte implementation choice).",
  "salinity_yield": "Relative yield = 100 - b (ECe - ECe_threshold) for ECe > threshold (Table 23, Ayers & Westcot 1985)"
 },
 "effective_rainfall": {
  "recommended": "Primary: run the FAO-56 daily root-zone water balance (Eq. 85) with runoff RO (e.g. USDA-SCS curve number) and deep percolation DP - this makes 'effective rainfall' implicit and is consistent with FAO-56.",
  "simple_alternative": {
   "name": "USDA Soil Conservation Service method as implemented in FAO CROPWAT (monthly)",
   "formula": "Peff = P (125 - 0.2 P) / 125 for P <= 250 mm/month; Peff = 125 + 0.1 P for P > 250 mm/month",
   "use": "Apply to monthly (or rolling 30-day) rainfall totals; for decadal/daily use FAO CROPWAT scales the monthly equation - do not apply to single-day rain.",
   "sources": [
    "Smith M. (1992) CROPWAT - a computer program for irrigation planning and management. FAO Irrigation and Drainage Paper 46",
    "pyCropWat documentation (https://montimaj.github.io/pyCropWat) reproducing the CROPWAT formula"
   ],
   "verification": "Formula verified only via secondary documentation; FAO-46 original not opened."
  },
  "other_cropwat_options": "CROPWAT also offers fixed-percentage, dependable-rain (FAO/AGLW) and empirical-formula methods; their coefficients were not verified in this research and are deliberately omitted."
 },
